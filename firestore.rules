rules_version = '2';

// قواعد أمان Firestore لمتجر الإمدادات
// - الزوار: قراءة الكتالوج المفعّل فقط + إنشاء طلب عرض سعر بصيغة محددة.
// - المشرفون (مستند في admins/{uid}): إدارة كاملة للكتالوج والطلبات.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function str(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }

    // ---------- الكتالوج ----------
    match /categories/{id} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }
    match /products/{id} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }
    match /portfolio/{id} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- الطلبات (طلبات عروض الأسعار) ----------
    function validItems(items) {
      return items is list && items.size() <= 30;
    }
    function validNewOrder(id, d) {
      return d.keys().hasAll(['ref', 'name', 'phone', 'serviceId', 'serviceName', 'description', 'items', 'status', 'source', 'consent', 'createdAt'])
        && d.keys().hasOnly(['ref', 'name', 'phone', 'email', 'serviceId', 'serviceName', 'description', 'items', 'status', 'source', 'consent', 'createdAt'])
        && d.ref == 'EM-' + id[0:6].upper()
        && str(d.name, 2, 100)
        && d.phone is string && d.phone.matches('^05[0-9]{8}$')
        && (!('email' in d) || (str(d.email, 3, 120) && d.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')))
        && str(d.serviceId, 1, 80)
        && str(d.serviceName, 1, 160)
        && str(d.description, 3, 500)
        && validItems(d.items)
        && d.status == 'new'
        && d.source == 'web'
        && d.consent == true
        && d.createdAt == request.time;
    }
    match /orders/{id} {
      allow create: if validNewOrder(id, request.resource.data);
      allow read, delete: if isAdmin();
      // المشرف يحدّث الحالة والملاحظات فقط، دون تعديل بيانات العميل
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'notes', 'updatedAt', 'updatedBy'])
        && request.resource.data.status in ['new', 'contacted', 'quoted', 'in_progress', 'done', 'cancelled'];
    }

    // ---------- المشرفون ----------
    // يُنشأ أول مشرف يدويًا من Firebase Console (انظر README).
    match /admins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }
  }
}
